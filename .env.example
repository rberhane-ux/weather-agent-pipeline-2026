# Copy this file to `.env` (same folder) and fill in your own values.
# Never commit the real .env file.

# Google Cloud Storage bucket that receives the raw and processed data
GCS_BUCKET_NAME=your-bucket-name

# Google Cloud project that owns the bucket
GOOGLE_CLOUD_PROJECT=your-project-id

# Path to your service account key (relative to the project root, or absolute).
# Keep the key file out of version control.
GOOGLE_APPLICATION_CREDENTIALS=your-service-account-key.json
